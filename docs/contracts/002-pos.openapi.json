{
  "openapi": "3.0.3",
  "info": {
    "title": "Archify Point of Sales API",
    "version": "1.0.0"
  },
  "servers": [{"url": "/api/v1"}],
  "paths": {
    "/stores": {"get": {"operationId": "listStores", "responses": {"200": {"description": "Store list"}}}},
    "/products": {"get": {"operationId": "listProducts", "responses": {"200": {"description": "Product list"}}}},
    "/sales": {"post": {"operationId": "createSale", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSale"}}}}, "responses": {"201": {"description": "Sale created"}, "422": {"description": "Validation error"}}}},
    "/sales/{saleId}": {"get": {"operationId": "getSale", "parameters": [{"$ref": "#/components/parameters/SaleId"}], "responses": {"200": {"description": "Sale detail"}, "404": {"description": "Sale not found"}}}}
  },
  "components": {
    "parameters": {"SaleId": {"name": "saleId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}},
    "schemas": {
      "CreateSale": {"type": "object", "required": ["store_id", "items", "payments"], "properties": {"store_id": {"type": "string", "format": "uuid"}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/SaleItem"}}, "payments": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/Payment"}}}},
      "SaleItem": {"type": "object", "required": ["product_id", "quantity"], "properties": {"product_id": {"type": "string", "format": "uuid"}, "quantity": {"type": "number", "exclusiveMinimum": 0}}},
      "Payment": {"type": "object", "required": ["method", "amount"], "properties": {"method": {"type": "string", "maxLength": 30}, "amount": {"type": "number", "exclusiveMinimum": 0}, "reference": {"type": "string", "maxLength": 120}}}
    }
  }
}
